# Copia a .env.local. No subas ese archivo.

# Fuente normal del challenge: mock sin red o REST mediante proxy same-origin.
VITE_PRODUCT_DATA_SOURCE=rest
VITE_PRODUCT_API_URL=/api/products

# Preparación opcional para crecimiento. Usa un gateway/BFF GraphQL compatible.
# VITE_PRODUCT_DATA_SOURCE=graphql
# VITE_GRAPHQL_API_URL=/api/graphql
# Solo permite gateways HTTPS explícitos, separados por coma.
# VITE_GRAPHQL_ALLOWED_ORIGINS=https://api.example.com

# Solo Node/Vite proxy. Nunca uses el prefijo VITE_ en la credencial.
RAPIDAPI_KEY=
